---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "KKL 2026 - Jelajah Wawasan & Pulau Dewata",
  description = "Dokumentasi kegiatan Kuliah Kerja Lapangan (KKL) mahasiswa Informatika Universitas PGRI Semarang di Bali: kunjungan industri, destinasi ikonik, dan kekayaan budaya.",
} = Astro.props;
---

<!doctype html>
<html lang="id" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b1120" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script is:inline>
      (() => {
        const applyTheme = (theme) => {
          document.documentElement.dataset.theme = theme;
          document
            .querySelector('meta[name="theme-color"]')
            ?.setAttribute("content", theme === "light" ? "#f3f5f8" : "#0b1120");
        };

        try {
          const saved = localStorage.getItem("kkl-theme");
          applyTheme(saved === "light" ? "light" : "dark");
        } catch {
          applyTheme("dark");
        }
      })();
    </script>
  </head>
  <body class="bg-[var(--bg-site)] font-sans text-[var(--text-strong)] antialiased">
    <slot />
  </body>
</html>
