---
import fs from "node:fs";
import path from "node:path";

const logoDir = path.join(process.cwd(), "public", "logos");
const logoFiles = fs.existsSync(logoDir) ? fs.readdirSync(logoDir) : [];
const allowedExtensions = new Set([".png", ".jpg", ".jpeg", ".webp", ".svg"]);

const findLogo = (keyword: string) => {
  const file = logoFiles.find((entry) => {
    const extension = path.extname(entry).toLowerCase();
    return allowedExtensions.has(extension) && entry.toLowerCase().includes(keyword);
  });

  return file ? `/logos/${encodeURIComponent(file)}` : undefined;
};

const logos = [
  {
    alt: "Logo Universitas PGRI Semarang",
    fallback: "UPGRIS",
    src: findLogo("upgris"),
  },
  {
    alt: "Logo Fakultas Teknik dan Informatika UPGRIS",
    fallback: "FTI",
    src: findLogo("fti"),
  },
  {
    alt: "Logo Program Studi Informatika UPGRIS",
    fallback: "INFORMATIKA",
    src: findLogo("informatika"),
  },
];

const navigation = [
  { label: "Beranda Utama", href: "/" },
  { label: "Rangkaian Timeline Jadwal", href: "/jadwal" },
  { label: "Highlight & Eksplorasi Wisata", href: "/eksplorasi" },
];

const members = [
  { name: "Novita Aulia Maharani", npm: "24670034" },
  { name: "HARDIKA PANGESTU", npm: "24670036" },
  { name: "Setyo Budi Utomo", npm: "24670037" },
  { name: "Affan Affandi", npm: "24670067" },
  { name: "Siti Komariyah", npm: "24670068" },
  { name: "Herlyan Setyawan", npm: "24670069" },
  { name: "Awanda Rosi Firdaus", npm: "24670105" },
  { name: "Prasetyo Adi Nugroho", npm: "24670106" },
  { name: "Devan Ardhareta Wardana", npm: "24670120" },
  { name: "Muhammad Akbar Ramadhan", npm: "24670121" },
  { name: "Mohammad Hadi Sofa", npm: "24670136" },
];
---

<section class="bg-[var(--bg-page-alt)] px-4 py-16 md:px-8 md:py-20" aria-labelledby="members-title">
  <div class="mx-auto w-full max-w-[1400px]">
    <header class="mb-8 flex flex-col gap-5 sm:flex-row sm:items-end sm:justify-between md:mb-10">
      <div>
        <h2 id="members-title" class="mt-3 text-[30px] font-extrabold leading-tight tracking-[-0.03em] text-[var(--text-strong)] sm:text-[36px] md:text-[44px]">
          Di balik layar perjalanan
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[var(--text-body)] md:text-base">
          Anggota KKL Informatika UPGRIS 2026.
        </p>
      </div>
    </header>

    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-5" aria-label="Anggota KKL Informatika UPGRIS 2026">
      {members.map((member, index) => (
        <li
          class:list={[
            "flex min-w-0 items-center gap-4 rounded-[26px] border border-[var(--border-soft)] bg-[var(--bg-card)] p-4 transition duration-300 hover:-translate-y-1 hover:shadow-[var(--card-hover-shadow)] sm:p-5",
            index === members.length - 1 && "xl:col-start-3",
          ]}
        >
          <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[var(--bg-soft)] text-sm font-bold text-[var(--accent)]" aria-hidden="true">
            {member.name.split(/\s+/).slice(0, 2).map((part) => part[0]).join("").toUpperCase()}
          </span>
          <span class="min-w-0">
            <span class="block text-sm font-semibold leading-snug text-[var(--text-strong)]">{member.name}</span>
            <span class="mt-1 block text-sm tabular-nums text-[var(--text-body)]">{member.npm}</span>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<footer class="border-t border-[var(--footer-border)] bg-[var(--footer-bg)] text-[var(--footer-text)]">
  <div
    class="mx-auto w-full max-w-[1400px] px-4 pb-9 pt-16 md:px-8 md:pb-10 md:pt-20"
  >
    <div
      class="grid gap-12 lg:grid-cols-[1.1fr_0.7fr_1.1fr] lg:gap-10 xl:gap-16"
    >
      <div>
        <p
          class="text-[17px] font-extrabold uppercase leading-none tracking-[0.04em] md:text-[18px]"
        >
          KKL Informatika 2026
        </p>
        <p class="mt-2 text-[13px] text-[var(--footer-muted)]">Universitas PGRI Semarang</p>

        <p
          class="mt-8 text-[10px] font-semibold uppercase tracking-[0.16em] text-[var(--footer-faint)]"
        >
          Support by
        </p>
        <div class="mt-4 flex flex-wrap items-center gap-2.5">
          {
            logos.map((logo) =>
              logo.src ? (
                <img
                  src={logo.src}
                  alt={logo.alt}
                  loading="lazy"
                  width="288"
                  height="147"
                  class="h-[44px] w-[86px] object-contain sm:h-[46px] sm:w-[90px] lg:h-[48px] lg:w-[94px]"
                />
              ) : (
                <div class="flex h-[44px] w-[86px] items-center justify-center rounded-lg bg-white px-3 sm:h-[46px] sm:w-[90px] lg:h-[48px] lg:w-[94px]">
                  <span class="text-center text-[9px] font-extrabold tracking-[0.08em] text-[#0d1b3f]/60">
                    {logo.fallback}
                  </span>
                </div>
              ),
            )
          }
        </div>
      </div>

      <nav aria-label="Navigasi footer">
        <h2
          class="text-[10.5px] font-bold uppercase tracking-[0.16em] text-[var(--accent)]"
        >
          Navigasi Halaman
        </h2>
        <ul class="mt-5 space-y-3.5">
          {
            navigation.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-[14px] text-[var(--footer-muted)] transition-colors hover:text-[var(--footer-text)]"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <address class="text-[13.5px] not-italic leading-[1.9] text-[var(--footer-muted)]">
          Program Studi Informatika · Fakultas Teknik dan Informatika<br />
          Universitas PGRI Semarang (UPGRIS)<br />
          Jl. Sidodadi Timur No. 24 – Dr. Cipto, Semarang, Jawa Tengah
        </address>

        <a
          href="mailto:informatika@upgris.ac.id"
          class="mt-5 inline-flex items-center gap-2 text-[13.5px] text-[var(--accent)] transition-colors hover:text-[var(--footer-text)]"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.6"
            stroke="currentColor"
            class="h-4 w-4 shrink-0"
          >
            <rect x="3" y="5" width="18" height="14" rx="2"></rect>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m3.5 7 8.5 6 8.5-6"
            ></path>
          </svg>
          informatika@upgris.ac.id
        </a>
      </div>
    </div>

    <div
      class="mt-14 flex flex-col gap-3 border-t border-[var(--footer-border)] pt-6 text-[11px] leading-relaxed text-[var(--footer-faint)] md:flex-row md:items-center md:justify-between"
    >
      <p>
        © 2026 Informatika Universitas PGRI Semarang. Seluruh hak cipta
        dilindungi.
      </p>
      <p>Dirancang untuk Dokumentasi KKL 2026</p>
    </div>
  </div>
</footer>
