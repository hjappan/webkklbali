---
import type { ExplorationItem } from "../data/explorations";

interface Props {
  item: ExplorationItem;
  variant?: "default" | "editorial";
}

const { item, variant = "default" } = Astro.props;
const isEditorial = variant === "editorial";
---

<a
  href={`/eksplorasi/${item.id}`}
  class:list={[
    "group flex h-full flex-col overflow-hidden rounded-2xl border border-[var(--border-soft)] bg-[var(--bg-card)] transition duration-300 hover:-translate-y-1",
    isEditorial
      ? "shadow-[0_16px_40px_-34px_rgba(15,27,63,0.45)] hover:shadow-[var(--card-hover-shadow)]"
      : "shadow-[0_18px_50px_-40px_rgba(15,27,63,0.5)] hover:shadow-[var(--card-hover-shadow)]",
  ]}
>
  <div class="relative aspect-[8/5] overflow-hidden">
    <img
      src={item.image}
      alt={item.alt}
      loading="lazy"
      style={item.imagePosition ? `object-position: ${item.imagePosition}` : undefined}
      class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.03]"
    />
    <span
      class:list={[
        "absolute rounded-md bg-[#1b2a4d]/95 font-bold uppercase text-white",
        isEditorial
          ? "left-3 top-3 px-2 py-1 text-[8px] tracking-[0.1em]"
          : "left-5 top-5 px-3 py-1.5 text-[10px] tracking-[0.12em]",
      ]}
    >
      {item.badge}
    </span>
  </div>

  <div
    class:list={[
      "flex flex-1 flex-col",
      isEditorial ? "p-4" : "p-6",
    ]}
  >
    <div
      class:list={[
        "flex flex-wrap items-start gap-x-3 gap-y-1.5",
        isEditorial ? "text-[11.5px]" : "text-[13.5px]",
      ]}
    >
      <span class="inline-flex items-center gap-2 text-[var(--text-muted)]">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.7"
          stroke="currentColor"
          class="h-4 w-4 shrink-0 text-[var(--accent)]"
        >
          <rect x="3" y="5" width="18" height="16" rx="2" />
          <path stroke-linecap="round" d="M16 3v4M8 3v4M3 11h18" />
        </svg>
        {item.date}
      </span>

      <span
        class="mt-[9px] h-1 w-1 shrink-0 rounded-full bg-[var(--text-muted)]"
        aria-hidden="true"
      ></span>

      <span class="inline-flex items-start gap-2 text-[var(--accent)]">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.7"
          stroke="currentColor"
          class="mt-0.5 h-4 w-4 shrink-0"
        >
          <path
            stroke-linejoin="round"
            d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"
          />
          <circle cx="12" cy="10" r="2.5" />
        </svg>
        <span class="leading-snug">{item.location}</span>
      </span>
    </div>

    <h2
      class:list={[
        "mt-3 text-[var(--text-strong)]",
        isEditorial
          ? "font-serif text-[18px] font-semibold leading-[1.35] tracking-[-0.01em]"
          : "text-[21px] font-bold leading-snug tracking-[-0.01em]",
      ]}
    >
      {item.title}
    </h2>

    <p
      class:list={[
        "mt-3 text-[var(--text-body)]",
        isEditorial
          ? "text-[12.5px] leading-[1.7]"
          : "text-[15px] leading-[1.8]",
      ]}
    >
      {item.description}
    </p>

    <div class:list={["mt-auto", isEditorial ? "pt-4" : "pt-6"]}>
      <div
        class:list={[
          "border-t border-[var(--border-soft)]",
          isEditorial ? "pt-3" : "pt-4",
        ]}
      >
        <span
          class:list={[
            "inline-flex items-center gap-2 text-[var(--text-strong)] transition-colors group-hover:text-[var(--accent-strong)]",
            isEditorial ? "text-[12.5px] font-medium" : "text-[15px] font-semibold",
          ]}
        >
          Jelajahi Cerita
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.8"
            stroke="currentColor"
            class="h-4 w-4"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M4 12h16m0 0-6-6m6 6-6 6"
            />
          </svg>
        </span>
      </div>
    </div>
  </div>
</a>
